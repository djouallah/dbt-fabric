# Copy to .env (gitignored). VS Code passes it to the notebook's kernel when the `run` and
# `parity` notebooks run on your laptop.
#
# The DEV workspace: the one deploy.yml installs as environment `dev`. Never the production
# workspace; production is built only by run_pipeline, in Fabric.
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
