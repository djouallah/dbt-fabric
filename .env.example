# Copy to .env (gitignored) for .github/scripts/dev.py.
#
# The DEV workspace: the one deploy.yml installs as environment `dev`. Never the production
# workspace; production is built only by run_pipeline, in Fabric.
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Optional. How many archive files each fact model folds per build; the Variable Library's
# value (1000) when unset. Set it low for a quick first build.
# process_limit=50
